{
  "name": "omp-compact-tool-calls",
  "version": "0.1.0",
  "description": "Compact, expandable tool-call presentation for the Oh My Pi terminal UI.",
  "type": "module",
  "license": "MIT",
  "main": "./index.ts",
  "exports": {
    ".": "./index.ts"
  },
  "omp": {
    "extensions": ["./index.ts"]
  },
  "engines": {
    "bun": ">=1.3.14"
  },
  "keywords": [
    "omp",
    "omp-extension",
    "oh-my-pi",
    "pi-package",
    "terminal",
    "tui",
    "tool-calls",
    "compact",
    "coding-agent"
  ],
  "files": [
    "index.ts",
    "contracts.ts",
    "renderer.ts",
    "ordinary-adapters.ts",
    "lifecycle-adapters.ts",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "docs/**/*.md"
  ],
  "scripts": {
    "test": "bun run --bun vitest run",
    "smoke": "bun scripts/smoke.ts",
    "check:package": "node scripts/check-package.mjs",
    "check": "npm test && npm run smoke && npm run check:package"
  },
  "peerDependencies": {
    "@oh-my-pi/pi-coding-agent": "18.8.7",
    "@oh-my-pi/pi-tui": "18.8.7"
  },
  "peerDependenciesMeta": {
    "@oh-my-pi/pi-coding-agent": {
      "optional": true
    },
    "@oh-my-pi/pi-tui": {
      "optional": true
    }
  },
  "devDependencies": {
    "@oh-my-pi/pi-coding-agent": "18.8.7",
    "@oh-my-pi/pi-tui": "18.8.7",
    "vitest": "4.1.11"
  }
}
